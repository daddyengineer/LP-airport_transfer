---
import Base from '../layouts/Base.astro';
import PromoBar from '../components/PromoBar.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
}

const { title, description, path, heading } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <PromoBar variant="line" />
  <SiteNav />
  <main class="prose">
    <h1>{heading}</h1>
    <slot />
  </main>
  <SiteFooter />
</Base>
